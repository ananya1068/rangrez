# Copy this file to .env and fill in real values before running

# Required for the AI chat / auto-cataloger (Multilingual Auto-Cataloger, AI Chat).
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Used to sign JWT session tokens. Set to any long random string in production.
JWT_SECRET=change-this-to-a-long-random-string

# SQLite file lives alongside the app by default; override if you want a different path.
DATABASE_URL=sqlite:///./rangrez.db

# In a real deployment this would be an SMS gateway (MSG91, Twilio, etc). For the
# hackathon demo, OTPs are generated server-side and returned in the API response
# instead of actually being sent, so the judges/frontend can see them without a
# telecom integration.
MOCK_SMS_MODE=true
